<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required to open IOMobileFramebuffer via IOServiceGetMatchingService. -->
    <key>com.apple.private.IOKit</key>
    <true/>

    <!-- Required to open the IOMobileFramebuffer display service. -->
    <key>com.apple.private.framebuffer</key>
    <true/>

    <!-- Suppresses the default app sandbox so the daemon can bind to
         /var/jb/var/run/dicoy.sock and write log files. -->
    <key>com.apple.private.security.no-container</key>
    <true/>

    <!-- Marks this binary as a platform application (required for private API
         access on rootless jailbreaks with CoreTrust bypass). -->
    <key>platform-application</key>
    <true/>
</dict>
</plist>
