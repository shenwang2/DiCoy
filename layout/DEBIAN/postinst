#!/bin/sh
set -e

# Detect jailbreak root prefix.
if [ -d /var/jb ] && [ -d /var/jb/Library ]; then
    P="/var/jb"
else
    P=""
fi

# Log file so we can see what happened even if everything is redirected.
LOG="${P}/var/log/dicoy-install.log"
mkdir -p "${P}/var/log"
mkdir -p "${P}/var/run"
exec >> "$LOG" 2>&1
echo "=== DiCoy postinst $(date) ==="
echo "JB prefix: $P"

# --------------------------------------------------------------------------
# Sandy sandbox-extension profile
# --------------------------------------------------------------------------
SANDY_DIR="${P}/Library/libSandy"
mkdir -p "$SANDY_DIR"

cat > "${SANDY_DIR}/DiCoy.plist" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AllowedProcesses</key>
	<array>
		<string>*</string>
	</array>
	<key>Extensions</key>
	<array>
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>${P}/var/mobile/Library/Preferences/com.dicoy.prefs.plist</string>
		</dict>
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>${P}/var/run/dicoy.sock</string>
		</dict>
		<dict>
			<key>type</key>
			<string>iokit_user_client</string>
			<key>extension_class</key>
			<string>com.apple.security.exception.iokit-user-client-class</string>
			<key>registry_entry_class</key>
			<string>IOSurfaceRootUserClient</string>
		</dict>
	</array>
</dict>
</plist>
PLISTEOF

chown root:wheel "${SANDY_DIR}/DiCoy.plist"
chmod 644 "${SANDY_DIR}/DiCoy.plist"
echo "Sandy profile written: ${SANDY_DIR}/DiCoy.plist"

# --------------------------------------------------------------------------
# Daemon registration
# --------------------------------------------------------------------------
DAEMON_BIN="${P}/usr/sbin/DiCoyDaemon"
LAUNCHD_PLIST="${P}/Library/LaunchDaemons/com.dicoy.daemon.plist"

echo "Daemon binary: $DAEMON_BIN"
echo "LaunchDaemon plist: $LAUNCHD_PLIST"

if [ ! -f "$DAEMON_BIN" ]; then
    echo "ERROR: daemon binary not found at $DAEMON_BIN — skipping registration"
else
    echo "Daemon binary exists ($(ls -la "$DAEMON_BIN"))"
    chmod 755 "$DAEMON_BIN"
fi

if [ ! -f "$LAUNCHD_PLIST" ]; then
    echo "ERROR: LaunchDaemon plist not found at $LAUNCHD_PLIST — skipping registration"
else
    echo "LaunchDaemon plist exists"

    # Prefer the JB-patched launchctl; fall back to system launchctl.
    LAUNCHCTL="${P}/usr/bin/launchctl"
    if [ ! -x "$LAUNCHCTL" ]; then
        LAUNCHCTL="launchctl"
    fi
    echo "Using launchctl: $LAUNCHCTL"

    # Remove any previous instance (ignore errors — nothing to remove on fresh install).
    "$LAUNCHCTL" bootout system "$LAUNCHD_PLIST" 2>&1 || true

    # Register and start the daemon.
    if "$LAUNCHCTL" bootstrap system "$LAUNCHD_PLIST" 2>&1; then
        echo "launchctl bootstrap: SUCCESS"
    else
        echo "launchctl bootstrap failed — trying launchctl load"
        if "$LAUNCHCTL" load "$LAUNCHD_PLIST" 2>&1; then
            echo "launchctl load: SUCCESS"
        else
            echo "launchctl load also failed — daemon will start on next reboot"
        fi
    fi
fi

echo "=== DiCoy postinst done ==="
