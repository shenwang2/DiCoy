#!/bin/sh
set -e

if [ -d /var/jb ] && [ -d /var/jb/Library ]; then
    P="/var/jb"
else
    P=""
fi

LOG="${P}/var/log/dicoy-install.log"
mkdir -p "${P}/var/log"
mkdir -p "${P}/var/run"
exec >> "$LOG" 2>&1
echo "=== DiCoy postinst $(date) ==="
echo "JB prefix: $P"

# --------------------------------------------------------------------------
# Sandy sandbox-extension profile
# --------------------------------------------------------------------------
SANDY_DIR="${P}/Library/libSandy"
mkdir -p "$SANDY_DIR"

cat > "${SANDY_DIR}/DiCoy.plist" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AllowedProcesses</key>
	<array>
		<string>*</string>
	</array>
	<key>Extensions</key>
	<array>
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>${P}/var/mobile/Library/Preferences/com.dicoy.prefs.plist</string>
		</dict>
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>${P}/var/run/dicoy.sock</string>
		</dict>
		<dict>
			<key>type</key>
			<string>iokit_user_client</string>
			<key>extension_class</key>
			<string>com.apple.security.exception.iokit-user-client-class</string>
			<key>registry_entry_class</key>
			<string>IOSurfaceRootUserClient</string>
		</dict>
	</array>
</dict>
</plist>
PLISTEOF

chown root:wheel "${SANDY_DIR}/DiCoy.plist"
chmod 644 "${SANDY_DIR}/DiCoy.plist"
echo "Sandy profile written: ${SANDY_DIR}/DiCoy.plist"

# --------------------------------------------------------------------------
# Clean up old standalone daemon (replaced by SpringBoard-hosted server).
# --------------------------------------------------------------------------
LAUNCHD_PLIST="${P}/Library/LaunchDaemons/com.dicoy.daemon.plist"
DAEMON_BIN="${P}/usr/sbin/DiCoyDaemon"

if [ -f "$LAUNCHD_PLIST" ]; then
    LAUNCHCTL="${P}/usr/bin/launchctl"
    [ -x "$LAUNCHCTL" ] || LAUNCHCTL="launchctl"
    "$LAUNCHCTL" bootout system "$LAUNCHD_PLIST" 2>/dev/null || true
    rm -f "$LAUNCHD_PLIST"
    echo "Removed old LaunchDaemon plist"
fi

if [ -f "$DAEMON_BIN" ]; then
    rm -f "$DAEMON_BIN"
    echo "Removed old daemon binary"
fi

echo "=== DiCoy postinst done ==="
