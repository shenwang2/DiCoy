<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Platform identity — bypasses sandbox and dyld restrictions -->
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.container-required</key>
    <false/>
    <key>com.apple.private.security.no-container</key>
    <true/>

    <!-- CARenderServer display capture (iOS 14+) -->
    <key>com.apple.private.coreanimation.render-server</key>
    <true/>
    <key>com.apple.CARenderServer</key>
    <true/>

    <!-- IOSurface cross-process access -->
    <key>com.apple.private.iosurface</key>
    <true/>
    <key>com.apple.iokit.IOSurfaceFamily</key>
    <true/>

    <!-- IOMobileFramebuffer access (display hardware layer) -->
    <key>com.apple.private.iomobileframebuffer.allow</key>
    <true/>
    <key>com.apple.private.framebuffer</key>
    <true/>

    <!-- General IOKit access -->
    <key>com.apple.private.IOKit</key>
    <true/>
</dict>
</plist>
