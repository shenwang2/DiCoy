<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AllowedProcesses</key>
	<array>
		<string>*</string>
	</array>
	<key>Extensions</key>
	<array>
		<!-- Preferences plist – real mobile home, no JB prefix -->
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>/var/mobile/Library/Preferences/com.dicoy.prefs.plist</string>
		</dict>
		<!-- Socket -->
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>/var/tmp/dicoy.sock</string>
		</dict>
		<!-- Diagnostic files written by the tweak inside camera-app processes -->
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>/var/tmp/dicoy_mode.txt</string>
		</dict>
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>/var/tmp/dicoy_surf.txt</string>
		</dict>
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>/var/tmp/dicoy_debug.txt</string>
		</dict>
		<!-- IOSurface cross-process lookup -->
		<dict>
			<key>type</key>
			<string>iokit_user_client</string>
			<key>extension_class</key>
			<string>com.apple.security.exception.iokit-user-client-class</string>
			<key>registry_entry_class</key>
			<string>IOSurfaceRootUserClient</string>
		</dict>
	</array>
</dict>
</plist>
